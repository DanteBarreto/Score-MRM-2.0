{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Preparar entorno",
      "detail": "Crea .venv e instala las dependencias (solo la primera vez)",
      "type": "shell",
      "windows": { "command": "python -m venv .venv; if ($?) { .venv\\Scripts\\python -m pip install -r requirements.txt }" },
      "linux": { "command": "python3 -m venv .venv && .venv/bin/python -m pip install -r requirements.txt" },
      "osx": { "command": "python3 -m venv .venv && .venv/bin/python -m pip install -r requirements.txt" },
      "problemMatcher": []
    },
    {
      "label": "2. Generar y abrir reporte",
      "detail": "Lee los Excel, crea output/reporte_mrm.html y lo abre en el navegador",
      "type": "process",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "linux": { "command": "${workspaceFolder}/.venv/bin/python" },
      "osx": { "command": "${workspaceFolder}/.venv/bin/python" },
      "args": ["src/generar_reporte.py", "--abrir"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "3. Ejecutar pruebas",
      "detail": "Comprueba que el proceso funciona de principio a fin",
      "type": "process",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "linux": { "command": "${workspaceFolder}/.venv/bin/python" },
      "osx": { "command": "${workspaceFolder}/.venv/bin/python" },
      "args": ["-m", "unittest", "discover", "-s", "tests"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
